############################################################
# Production multi-stage Dockerfile (uv only in builder)
# Build: docker build --build-arg INSPEKTO_AGENT_BASE_IMAGE_TAG=debian:bookworm-slim -t myplayground:latest .
############################################################

ARG BASE_IMAGE_TAG

##############################
# Builder Stage
##############################
FROM ${BASE_IMAGE_TAG} AS builder
ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv python3-pip \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3 /usr/bin/python

WORKDIR /build

# Create isolated venv for build
RUN python -m venv /venv
ENV PATH="/venv/bin:${PATH}"

# Install uv (fast resolver) and build tooling
RUN pip install --upgrade pip uv build

COPY pyproject.toml uv.lock ./
COPY app ./app

# Sync only prod deps (no dev) using lock file (project not yet installed)
RUN uv sync --frozen --no-install-project

# Build wheel (ensures reproducible artifact)
RUN python -m build --wheel --no-isolation

##############################
# Runtime Stage (minimal)
##############################
FROM ${BASE_IMAGE_TAG} AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv python3-pip \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3 /usr/bin/python

WORKDIR /app

# Create runtime venv (smaller than copying entire builder venv)
RUN python -m venv /venv
ENV PATH="/venv/bin:${PATH}"

# Copy wheel from builder
COPY --from=builder /build/dist/*.whl /app/

# Install the wheel only (pinned transitive deps from builder lock)
RUN pip install --upgrade pip && pip install --no-cache-dir ./*.whl && rm -f ./*.whl

# Non-root user
RUN useradd -m appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

ENV UVICORN_HOST=0.0.0.0 \
    UVICORN_PORT=8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

